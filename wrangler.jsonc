// Cloudflare deploys this repository as one Worker: the password gate, the AI relay and the map.
// Only the public/ folder is ever served, and only after the family password.
{
  "name": "tripoli-atlas-ai",
  "main": "worker/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    { "binding": "ATLAS_KV", "id": "da3be61a14e648f291931b3d321b3d3d" }
  ],
  // Keep the variables already set in the Cloudflare dashboard (credit, owner name, etc.).
  "keep_vars": true,
  "observability": { "enabled": true }
}
