// Cloudflare deploys this repository as one Worker: the AI relay, family sign-in and the map.
// The map (public/) is open read-only and served straight from static files, so visitors never run
// the Worker. /login, /logout and /api have no file, so they reach worker/worker.js.
{
  "name": "tripoli-atlas-ai",
  "main": "worker/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "kv_namespaces": [
    { "binding": "ATLAS_KV", "id": "da3be61a14e648f291931b3d321b3d3d" }
  ],
  // Keep the variables already set in the Cloudflare dashboard (credit, owner name, etc.).
  "keep_vars": true,
  "observability": { "enabled": true }
}
